{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://periggouanvic.github.io/ada-format/spec/manifest-v0.1.schema.json",
  "title": "manifest.json of an .ada archive, format version 0.1 (draft)",
  "description": "See spec/ada-v0.1.md, section 3.",
  "type": "object",
  "required": ["format_version", "subject", "author", "language"],
  "additionalProperties": true,
  "properties": {
    "format_version": { "const": "0.1" },
    "subject": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mode": { "enum": ["encoded_from_source", "grown_from_deposits"] },
    "feedback": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["method", "target"],
        "properties": {
          "method": { "enum": ["mailto", "url"] },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bibliography"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bibliography": { "type": "string" },
          "doi": { "type": "string" },
          "url": { "type": "string" },
          "supports_claims": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "version": { "type": "string" },
    "license": { "type": "string" },
    "source": {
      "type": "object",
      "properties": {
        "uri": { "type": "string" },
        "citation": { "type": "string" }
      }
    },
    "encoded_by": {
      "type": "object",
      "required": ["who"],
      "properties": {
        "who": { "type": "string" },
        "method": { "enum": ["human", "ai-assisted", "ai"] }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "status"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "status": { "enum": ["established", "argued", "hypothesis", "speculative"] },
          "citations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
