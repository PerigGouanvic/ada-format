{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://periggouanvic.github.io/ada-format/spec/ada-v0.1.schema.json",
  "title": ".ada document, format version 0.1 (draft)",
  "description": "Schema applied to the parsed YAML of an .ada file. See spec/ada-v0.1.md.",
  "type": "object",
  "required": ["ada", "meta", "sections"],
  "additionalProperties": false,
  "properties": {
    "ada": { "const": "0.1" },
    "meta": {
      "type": "object",
      "required": ["title", "language"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "contact": { "type": "string" }
            }
          }
        },
        "version": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "license": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["original", "encoded"] },
            "uri": { "type": "string" },
            "citation": { "type": "string" }
          }
        },
        "encoded_by": {
          "type": "object",
          "properties": {
            "who": { "type": "string" },
            "method": { "enum": ["human", "ai-assisted", "ai"] },
            "models": { "type": "array", "items": { "type": "string" } },
            "date": { "type": "string" }
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "properties": {
        "central_question": { "type": "string" },
        "thesis": { "type": "string" },
        "must_keep": { "type": "array", "items": { "type": "string" } },
        "audiences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "wants": { "type": "string" },
              "start_with": { "type": "array", "items": { "$ref": "#/$defs/id" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "term", "definition"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "term": { "type": "string" },
          "definition": { "type": "string" },
          "plain": { "type": "string" },
          "requires": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "for": { "$ref": "#/$defs/id" }
              }
            }
          },
          "not_to_confuse_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["context", "claim", "argument", "evidence", "example", "objection", "reply", "method", "conclusion", "aside"]
          },
          "summary": { "type": "string" },
          "levels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plain": { "type": "string" },
              "standard": { "type": "string" },
              "expert": { "type": "string" }
            }
          },
          "uses": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "status"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "text": { "type": "string" },
                "status": { "enum": ["established", "argued", "hypothesis", "speculative"] },
                "sources": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "difficulties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["what"],
              "properties": {
                "what": { "type": "string" },
                "why": { "type": "string" },
                "help": { "type": "string" }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["to", "relation"],
              "properties": {
                "to": { "$ref": "#/$defs/id" },
                "relation": { "enum": ["supports", "answers", "contradicts", "illustrates", "extends", "see_also"] }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q"],
        "properties": {
          "q": { "type": "string" },
          "answer": { "type": "string" },
          "see": { "type": "array", "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "decoder": {
      "type": "object",
      "properties": {
        "voice": { "enum": ["neutral_guide", "first_person_author", "tutor"] },
        "default_entry": { "$ref": "#/$defs/id" },
        "rules": { "type": "array", "items": { "type": "string" } },
        "prompt": { "type": "string" }
      }
    },
    "feedback": {
      "type": "object",
      "properties": {
        "contact": { "type": "string" },
        "invite": { "type": "boolean" },
        "ask_for": {
          "type": "array",
          "items": { "enum": ["unclear_passages", "missing_examples", "disagreements", "errors"] }
        }
      }
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" }
  }
}
